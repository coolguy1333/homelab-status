# Copy to .env and edit. Every setting is optional.

# Port and address to listen on
PORT=3000
HOST=0.0.0.0

# ---- Sign-in -------------------------------------------------------------
# The site has no sign-in of its own: put Cloudflare Access in front of the domain
# (see docs/CLOUDFLARE_ACCESS.md). Your team domain and the Access application's AUD tag:
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional second check: only these emails count as signed in (comma-separated; @domain.com = a whole domain).
# Empty = whoever your Access policy lets in.
ADMIN_EMAILS=
# Public address you open the dashboard on, e.g. https://status.example.com
PUBLIC_URL=

# API token for scripts (Authorization: Bearer ...). If empty, one is generated into data/admin-password.txt
ADMIN_PASSWORD=

# ---- Claude connector (read-only MCP server at $PUBLIC_URL/mcp) -----------
# On by default when PUBLIC_URL is set. See docs/CONFIGURATION.md#claude-connector-mcp
#MCP_ENABLED=true
#MCP_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# ---- Other ---------------------------------------------------------------
# Where monitors, history and settings are stored (relative to this folder)
DATA_DIR=./data

# Site title used on first start (change later in Settings)
SITE_TITLE=Uptime Monitor

# Name other servers show for this one when you run several (default: the site title)
#SERVER_NAME=

# First-start default: false = login required to view the dashboard
PUBLIC_DASHBOARD=true

# Comma-separated webhook URLs (Discord, Slack, ntfy, or any JSON endpoint)
NOTIFY_WEBHOOK_URL=

# Set to true when behind a reverse proxy (Caddy, nginx, Traefik, Cloudflare Tunnel)
TRUST_PROXY=false

# Allow the dashboard inside an iframe (Homepage, Heimdall, Home Assistant, ...)
ALLOW_EMBED=false

# ---- Multi-server (peer federation) --------------------------------------
# Comma-separated base URLs of other Uptime Monitor instances to federate with.
# Each one shows up in "Other servers" on every instance in the group, with no
# single instance required to be up for the rest to see each other.
#PEERS=https://status-eu.example.com,https://status-us.example.com
# Shared secret sent as "Authorization: Bearer <PEER_TOKEN>" between peers.
# Strongly recommended: without it, /api/peer-status is public and unauthenticated
# (it only ever exposes this server's own uptime numbers, never monitors or targets).
# Also turns on two-way monitor sync between the servers. Use the same value on every server in the group.
#PEER_TOKEN=
