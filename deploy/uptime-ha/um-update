#!/usr/bin/env python3
"""um-update: installs new versions of Homelab Status from GitHub (main), like WebManager's updater.

  um-update              timer run (every 5 min): check GitHub; install the new version if automatic
                         installation is on (the default) and that version hasn't already failed here
  um-update --check      only check GitHub and record what's available
  um-update --install C  install commit C, but only if C is the newest commit on main (so a request can't
                         pick arbitrary code), even if automatic installation is off or C failed before

An install is tested first: every script must parse, and the new app must start and answer /api/health on a
spare port with a copy of the data (webhooks removed, so a test can't send alerts). Then the current code and
data are backed up, and the new code is installed. If the app was running (primary) it restarts, and if it
doesn't answer /api/health within 40 s the old code is put back. A running app restarts for about 2 s, well
under um-ha's FAIL_AFTER, so an update never causes a failover. um-ha shows the result (update.json) to the
dashboard's Servers page, and it starts this with --check/--install when someone clicks there.
"""
import fcntl
import hashlib
import json
import os
import shutil
import socket
import subprocess
import sys
import tarfile
import time
import urllib.request

SRC = "/opt/homelab-status-src"
APP = "/opt/uptime-monitor"
PREV = "/opt/uptime-monitor.prev"
DATA = "/var/lib/uptime-monitor"
STATE_DIR = "/var/lib/um-ha"
STATUS = os.path.join(STATE_DIR, "update.json")
REV = os.path.join(STATE_DIR, "installed-rev")
AUTO = os.path.join(STATE_DIR, "auto-install")       # "0" = off; missing or anything else = on
LOCK = os.path.join(STATE_DIR, "update.lock")
BACKUPS = os.path.join(STATE_DIR, "backups")
APP_FILES = ("server.js", "package.json", "package-lock.json", "lib", "public", "node_modules")   # missing ones are skipped
UNITS = ("um-ha.service", "um-update.service", "um-update.timer")
ATTEMPT = {"commit": None}   # set once an install starts: a failure after that marks this commit as failed


def log(msg):
    print(msg, flush=True)


def run(cmd, timeout=120, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)


def git(*args, timeout=60):
    r = run(["git", "-C", SRC, *args], timeout=timeout)
    if r.returncode:
        raise RuntimeError(f"git {' '.join(args)}: {(r.stderr or r.stdout).strip()[-300:]}")
    return r.stdout.strip()


def read_status():
    try:
        with open(STATUS) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def write_status(**kw):
    d = read_status()
    d.update(kw)
    d["installed_commit"] = installed()
    d["version"] = app_version()
    tmp = STATUS + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.replace(tmp, STATUS)
    return d


def installed():
    try:
        return open(REV).read().strip() or None
    except OSError:
        return None


def app_version():
    try:
        return json.load(open(os.path.join(APP, "package.json"))).get("version")
    except (OSError, ValueError):
        return None


def auto_install():
    try:
        return open(AUTO).read().strip() != "0"
    except OSError:
        return True


def now_ms():
    return int(time.time() * 1000)


def app_active():
    return run(["systemctl", "is-active", "--quiet", "uptime-monitor"]).returncode == 0


def healthy(port, seconds, proc=None):
    end = time.time() + seconds
    while time.time() < end:
        if proc is not None and proc.poll() is not None:
            return False   # it exited: no point waiting
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/health", timeout=2) as r:
                if r.status == 200:
                    return True
        except OSError:
            pass
        time.sleep(0.5)
    return False


def env_file():
    env = {}
    try:
        for line in open("/etc/uptime-monitor.env"):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1].replace('\\"', '"').replace("\\\\", "\\")
                env[k.strip()] = v
    except OSError:
        pass
    return env


def app_port():
    try:
        return int(env_file().get("PORT") or 3000)
    except ValueError:
        return 3000


# ------------------------------------------------------------------ check

def check():
    git("fetch", "-q", "origin", "main", timeout=90)
    latest = git("rev-parse", "origin/main")
    cur = installed()
    st = read_status()
    if st.get("state") == "installing":
        # check() runs under the update lock, so no install is running: the last one was cut off (reboot, killed).
        tgt = st.get("target_commit") or ""
        st = write_status(state="error", failed_commit=tgt or None,
                          message=f"The update to {tgt[:12] or 'a new version'} was interrupted before it finished.",
                          detail="Click Install to try it again. The version shown is the one that runs now.")
    if latest == cur:
        return write_status(state="current", available_commit=latest, checked_at=now_ms(),
                            message="Up to date.", detail=None)
    if st.get("state") == "error" and st.get("failed_commit") == latest:
        return write_status(available_commit=latest, checked_at=now_ms())   # keep showing the failure
    return write_status(state="available", available_commit=latest, checked_at=now_ms(),
                        message=f"Version {latest[:12]} is available.", detail=None)


# ------------------------------------------------------------------ dependencies

def lock_hash(tree):
    try:
        with open(os.path.join(tree, "package-lock.json"), "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


def install_deps(tree):
    """npm ci --omit=dev in the source tree, skipped when node_modules already matches package-lock.json.
    Without npm the app still runs, only the Claude connector (/mcp) is off: say so instead of failing the update."""
    want = lock_hash(tree)
    if not want:
        return
    stamp = os.path.join(tree, "node_modules", ".um-lock-sha256")
    try:
        if open(stamp).read().strip() == want:
            return
    except OSError:
        pass
    if not shutil.which("npm"):
        log("npm is not installed (apt install npm): the app runs, but the Claude connector stays off until it is")
        return
    r = run(["npm", "ci", "--omit=dev", "--ignore-scripts", "--no-audit", "--no-fund"], timeout=600, cwd=tree)
    if r.returncode:
        raise RuntimeError(f"npm ci failed:\n{(r.stderr or r.stdout).strip()[-800:]}")
    with open(stamp, "w") as f:
        f.write(want + "\n")


def repair_deps():
    """The installed app lacks the node_modules its package-lock.json needs (the first install of 2.15 is done by
    the old um-update, which didn't copy them): install them now and restart the app."""
    want = lock_hash(SRC)   # the old um-update didn't copy package-lock.json either
    if not want or not os.path.isdir(APP) or installed() != git("rev-parse", "HEAD"):
        return
    try:
        if open(os.path.join(APP, "node_modules", ".um-lock-sha256")).read().strip() == want:
            return
    except OSError:
        pass
    install_deps(SRC)
    if not os.path.exists(os.path.join(SRC, "node_modules", ".um-lock-sha256")):
        return   # no npm: install_deps said so
    shutil.copy2(os.path.join(SRC, "package-lock.json"), os.path.join(APP, "package-lock.json"))
    d = os.path.join(APP, "node_modules")
    shutil.rmtree(d + ".new", ignore_errors=True)
    shutil.copytree(os.path.join(SRC, "node_modules"), d + ".new")
    shutil.rmtree(d, ignore_errors=True)
    os.rename(d + ".new", d)
    log("installed the app's node_modules")
    if app_active():
        run(["systemctl", "restart", "uptime-monitor"], timeout=90)


# ------------------------------------------------------------------ test

def test_version(tree):
    """Parse every script, then boot the new app on a spare port with a copy of the data."""
    for root, _, files in os.walk(tree):
        if "/node_modules" in root or "/.git" in root:
            continue
        for n in files:
            p = os.path.join(root, n)
            if n.endswith(".js") and ("/lib" in root or "/public" in root or root == tree):
                r = run(["node", "--check", p])
                if r.returncode:
                    raise RuntimeError(f"{os.path.relpath(p, tree)} does not parse:\n{r.stderr.strip()[-800:]}")
    for p in ("deploy/uptime-ha/um-ha", "deploy/uptime-ha/um-update"):
        r = run(["python3", "-c", "import ast,sys; ast.parse(open(sys.argv[1]).read())", os.path.join(tree, p)])
        if r.returncode:
            raise RuntimeError(f"{p} does not parse:\n{r.stderr.strip()[-800:]}")

    test_data = "/var/lib/uptime-monitor-test"
    shutil.rmtree(test_data, ignore_errors=True)
    shutil.copytree(DATA, test_data) if os.path.isdir(DATA) else os.makedirs(test_data)
    sf = os.path.join(test_data, "settings.json")
    try:
        s = json.load(open(sf))
        s["webhooks"] = []
        json.dump(s, open(sf, "w"))
    except (OSError, ValueError):
        pass
    shutil.chown(test_data, "uptime", "uptime")
    for n in os.listdir(test_data):
        shutil.chown(os.path.join(test_data, n), "uptime", "uptime")
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
    env = {**env_file(), "PATH": "/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin", "NODE_ENV": "production",
           "PORT": str(port), "HOST": "127.0.0.1", "DATA_DIR": test_data, "NOTIFY_WEBHOOK_URL": "", "PEERS": ""}
    try:
        p = subprocess.Popen(["/usr/sbin/runuser", "-u", "uptime", "--", "node", os.path.join(tree, "server.js")],
                             env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, cwd=tree)
        try:
            ok = healthy(port, 25, p)
        finally:
            p.terminate()
            try:
                out = p.communicate(timeout=10)[0]
            except subprocess.TimeoutExpired:
                p.kill()
                out = p.communicate()[0]
    finally:
        shutil.rmtree(test_data, ignore_errors=True)
    if not ok:
        raise RuntimeError(f"the new version did not start (no answer on /api/health):\n{out[-1500:]}")


# ------------------------------------------------------------------ install

def copy_app(tree, dst):
    os.makedirs(dst, exist_ok=True)
    for n in APP_FILES:
        s, d = os.path.join(tree, n), os.path.join(dst, n)
        if not os.path.exists(s):
            continue
        if os.path.isdir(d):
            shutil.rmtree(d)
        (shutil.copytree if os.path.isdir(s) else shutil.copy2)(s, d)


def backup_data(commit):
    os.makedirs(BACKUPS, exist_ok=True)
    path = os.path.join(BACKUPS, f"{time.strftime('%Y%m%d-%H%M%S')}-before-update-{commit[:7]}.tar.gz")
    with tarfile.open(path, "w:gz", compresslevel=1) as tar:
        for n in sorted(os.listdir(DATA)):
            if not n.endswith(".tmp"):
                tar.add(os.path.join(DATA, n), arcname=n)
    for n in sorted(os.listdir(BACKUPS))[:-8]:
        os.unlink(os.path.join(BACKUPS, n))


def install(commit, manual):
    latest = git("rev-parse", "origin/main")
    if commit != latest:
        raise RuntimeError(f"only the newest version of main ({latest[:12]}) can be installed, not {commit[:12]}")
    if commit == installed():
        write_status(state="current", message="Already up to date.", detail=None)
        return
    if not git("cat-file", "-t", f"{commit}:deploy/uptime-ha/um-ha"):
        raise RuntimeError("that version has no deploy/uptime-ha")
    old = installed()
    ATTEMPT["commit"] = commit
    write_status(state="installing", target_commit=commit, started_at=now_ms(),
                 message=f"Testing {commit[:12]}…", detail=None)
    git("reset", "-q", "--hard", commit)
    try:
        install_deps(SRC)
        test_version(SRC)
    except Exception as e:
        if old:
            git("reset", "-q", "--hard", old)
        raise RuntimeError(f"Test failed, nothing was changed. {e}")

    write_status(message=f"Backing up and installing {commit[:12]}…")
    if os.path.isdir(DATA):
        backup_data(commit)
    shutil.rmtree(PREV, ignore_errors=True)
    if os.path.isdir(APP):
        shutil.copytree(APP, PREV)
    was_running = app_active()

    def put_back(why):
        if os.path.isdir(PREV):
            shutil.rmtree(APP, ignore_errors=True)
            shutil.copytree(PREV, APP)
        if was_running:
            run(["systemctl", "restart", "uptime-monitor"], timeout=90)
        if old:
            git("reset", "-q", "--hard", old)
        raise RuntimeError(f"{why}, so the previous version was put back.")

    try:
        copy_app(SRC, APP)
    except OSError as e:   # e.g. disk full halfway: never leave half-new code behind
        put_back(f"Copying the new version failed ({e})")
    if was_running:
        run(["systemctl", "restart", "uptime-monitor"], timeout=90)
        if not healthy(app_port(), 40):
            journal = run(["journalctl", "-u", "uptime-monitor", "-n", "30", "--no-pager", "-o", "cat"]).stdout
            try:
                put_back("The app did not come back after the update")
            except RuntimeError as e:
                raise RuntimeError(f"{e}\n{journal[-1500:]}")

    with open(REV, "w") as f:
        f.write(commit + "\n")
    # System files last: units, the updater itself, and um-ha (restarting um-ha never interrupts the app).
    changed = run(["git", "-C", SRC, "diff", "--name-only", old or "HEAD~1", commit]).stdout if old else "deploy/"
    if "deploy/" in changed:
        shutil.copy2(os.path.join(SRC, "deploy/uptime-monitor.service"), "/etc/systemd/system/uptime-monitor.service")
        for u in UNITS:
            shutil.copy2(os.path.join(SRC, "deploy/uptime-ha", u), f"/etc/systemd/system/{u}")
        run(["systemctl", "daemon-reload"])
        for n in ("um-update", "um-ha"):
            src, dst = os.path.join(SRC, "deploy/uptime-ha", n), f"/usr/local/sbin/{n}"
            if run(["cmp", "-s", src, dst]).returncode:
                shutil.copy2(src, dst + ".new")
                os.chmod(dst + ".new", 0o755)
                os.replace(dst + ".new", dst)
                log(f"{n} updated")
    write_status(state="current", available_commit=commit, installed_at=now_ms(), checked_at=now_ms(),
                 message=f"Version {app_version()} ({commit[:12]}) installed{' by request' if manual else ''}.",
                 detail=None, failed_commit=None)
    log(f"installed {commit[:12]} (app {app_version()}){', app restarted' if was_running else ''}")
    if "deploy/uptime-ha/um-ha" in changed:
        run(["systemctl", "restart", "um-ha"])


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    args = sys.argv[1:]
    lockf = open(LOCK, "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("another update is already running")
        return 0
    try:
        st = check()
        if args[:1] == ["--check"]:
            log(st.get("message", ""))
            return 0
        if args[:1] == ["--install"] and len(args) > 1:
            install(args[1], manual=True)
            return 0
        if st.get("state") == "available" and auto_install():
            install(st["available_commit"], manual=False)
        else:
            log(st.get("message", ""))
            repair_deps()
        return 0
    except Exception as e:
        msg = str(e)
        first, _, rest = msg.partition("\n")
        if ATTEMPT["commit"]:
            write_status(state="error", message=first, detail=rest or None, failed_commit=ATTEMPT["commit"])
        elif args[:1] == ["--install"]:   # refused before anything changed
            write_status(message=f"Update not started: {first}", detail=rest or None)
        else:   # couldn't even check (GitHub unreachable...): say so, but don't mark any version as failed
            write_status(state="error", message=f"Could not check for updates: {first}", detail=rest or None)
        log(f"update failed: {msg}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
